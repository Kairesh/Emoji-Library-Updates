<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.antigravity.emojilib" ExtensionBundleVersion="2.8.6"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.antigravity.emojilib.panel" Version="2.8.6" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- After Effects -->
            <Host Name="AEFT" Version="[13.0,99.9]" />
            <!-- Premiere Pro -->
            <Host Name="PPRO" Version="[10.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="7.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.antigravity.emojilib.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./host/index.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                        <Parameter>--allow-file-access-from-files</Parameter>
                        <Parameter>--disable-web-security</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Emoji Library by Kairesh</Menu>
                    <Geometry>
                        <Size>
                            <Width>340</Width>
                            <Height>650</Height>
                        </Size>
                        <MinSize>
                            <Width>280</Width>
                            <Height>400</Height>
                        </MinSize>
                        <MaxSize>
                            <Width>1200</Width>
                            <Height>1600</Height>
                        </MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
